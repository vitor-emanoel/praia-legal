# Copie para .env e preencha
PORT=3000
# Simulação local do login Google/Facebook e conta de teste. Use false em produção.
DEMO_MODE=true
BASE_URL=http://localhost:3000
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
# NODE_ENV=production   # em produção o link de reset não é devolvido na resposta

# Praia padrão do app
BEACH_NAME=Praia de Boa Viagem, Recife
BEACH_LAT=-8.1186
BEACH_LON=-34.9006
BEACH_RADIUS=2500

# Login com Facebook (developers.facebook.com > Criar app > Login do Facebook)
# URI de redirecionamento OAuth válido: BASE_URL/auth/facebook/callback
FB_APP_ID=
FB_APP_SECRET=

# Login com Google (console.cloud.google.com > Credenciais > ID do cliente OAuth)
# URI de redirecionamento autorizado: BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: dados de lojas do Google (mais completo que o OpenStreetMap)
GOOGLE_PLACES_KEY=

# Assistente de IA (opcional para respostas gerais; mantenha a chave somente no servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
